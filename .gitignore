# Generated by ./setup.sh and xewe; never committed (rebuilt from xewe.toml).
build/
# src/Modules.h: includes and declares the selected modules (written by xewe modules generate).
src/Modules.h
# run.sh: written by ./setup.sh on every run.
/run.sh

# Credentials and settings for xewe provision/test; yours to create (the tools README lists the keys).
.env

# static/firmware/releases/<version>/ is written by `xewe release`; CI publishes it as GitHub Release assets. Never committed.
/static/firmware/releases/*
!/static/firmware/releases/.gitkeep
# The local logs of a release card run (releases/<version>/release_card.md is committed, its logs are not).
releases/*/logs/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Python bytecode, virtual environments and lint cache written by xewe test / pytest / ruff
__pycache__/
.venv/
.ruff_cache/

# Local notes kept out of the repository
doc/standards.md
