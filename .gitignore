# Generated by ./setup.sh and xewe; never committed (rebuilt from xewe.toml).
build/
# src/Modules.h: includes and declares the selected modules (written by xewe modules generate).
src/Modules.h
# run.sh: written by ./setup.sh on every run.
/run.sh

# Credentials and settings for xewe provision/test; yours to create (the tools README lists the keys).
# The dot-suffixed variants (per bench, per board) are ignored too.
.env
.env.*

# Release images: GitHub Release assets, written under static/ at release time, never committed.
/static/
# releases/<version>/logs/ are local run logs (D27).
releases/*/logs/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Python bytecode and lint cache written by xewe test / pytest / ruff
__pycache__/
.ruff_cache/

# Python virtual environments
.venv/

# Local notes kept out of the repository
doc/standards.md
