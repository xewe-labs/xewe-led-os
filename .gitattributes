# Media under static/media/ are stored in Git LFS (images, video and documents; the HomeKit
# setup QR is static/media/HomeKit_Connect_QR.png). Nothing under static/firmware/ is committed:
# release images are GitHub Release assets (see README "Install").
static/media/**/*.png     filter=lfs diff=lfs merge=lfs -text
static/media/**/*.jpg     filter=lfs diff=lfs merge=lfs -text
static/media/**/*.jpeg    filter=lfs diff=lfs merge=lfs -text
static/media/**/*.gif     filter=lfs diff=lfs merge=lfs -text
static/media/**/*.webp    filter=lfs diff=lfs merge=lfs -text
static/media/**/*.mp4     filter=lfs diff=lfs merge=lfs -text
static/media/**/*.mov     filter=lfs diff=lfs merge=lfs -text
static/media/**/*.pdf     filter=lfs diff=lfs merge=lfs -text
static/media/**/*.numbers filter=lfs diff=lfs merge=lfs -text
